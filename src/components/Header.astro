---
// Header component for panorama_biblico
// Updated to use Tailwind CSS with clean design system
---

<header class="sticky top-0 z-50 w-full bg-white/90 dark:bg-gray-900/90 backdrop-blur-md border-b border-border">
  <div class="container h-full flex items-center justify-between">
    {/* Logo and site name */}
    <a href="/" class="flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-primary rounded-lg p-1">
      <div class="h-8 w-8 rounded bg-gradient-to-r from-primary to-secondary" />
      <span class="font-semibold text-primary dark:text-inverse">Panorama Bíblico</span>
    </a>

    {/* Desktop navigation */}
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-muted hover:text-primary dark:text-muted/80 dark:hover:text-primary">Início</a>
      <a href="/antigo-testamento" class="text-muted hover:text-primary dark:text-muted/80 dark:hover:text-primary">Antigo Testamento</a>
      <a href="/novo-testamento" class="text-muted hover:text-primary dark:text-muted/80 dark:hover:text-primary">Novo Testamento</a>
      <a href="/como-ler-biblia" class="text-muted hover:text-primary dark:text-muted/80 dark:hover:text-primary">Como Ler a Bíblia</a>
    </nav>

    {/* Mobile menu button */}
    <button
      id="mobile-menu-button"
      type="button"
      aria-label="Abrir Menu"
      aria-expanded="false"
      class="md:hidden min-h-[48px] min-w-[48px] flex items-center justify-center text-muted dark:text-muted/80 rounded-lg hover:bg-primary/10 dark:hover:bg-primary/10 transition-colors"
    >
      {/* Burger icon (default, menu closed) */}
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  {/* Mobile menu */}
  <nav id="mobile-menu" class="md:hidden hidden bg-white dark:bg-gray-900 border-b border-border">
    <div class="px-4 py-3 flex flex-col gap-3 text-sm font-medium">
      <a href="/" class="text-primary dark:text-inverse py-2" >Início</a>
      <a href="/antigo-testamento" class="text-primary dark:text-inverse py-2" >Antigo Testamento</a>
      <a href="/novo-testamento" class="text-primary dark:text-inverse py-2" >Novo Testamento</a>
      <a href="/como-ler-biblia" class="text-primary dark:text-inverse py-2" >Como Ler a Bíblia</a>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    menu.classList.toggle('hidden');

    // Update the icon: burger <-> X
    const svg = button.querySelector('svg');
    if (isOpen) {
      // Show burger icon (menu is closing)
      svg.innerHTML = '<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />';
    } else {
      // Show X icon (menu is opening)
      svg.innerHTML = '<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" />';
    }
  });
</script>