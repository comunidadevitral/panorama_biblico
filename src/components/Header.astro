---
// Header component for panorama_biblico
// This component replicates the original Header.jsx from the React site
// but uses Astro and Tailwind CSS.
---

<header class="sticky top-0 z-50 w-full h-16 bg-white/90 dark:bg-vitral-bg-dark/90 backdrop-blur-md border-b border-vitral-secondary/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
    {/* Logo and site name */}
    <a href="/" class="flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-vitral-primary rounded-lg p-1">
      <div class="h-8 w-8 rounded bg-vitral-gradient" />
      <span class="font-semibold text-vitral-dark dark:text-white">Panorama Bíblico</span>
    </a>

    {/* Desktop navigation */}
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-vitral-dark hover:text-vitral-primary dark:text-white">Início</a>
      <a href="/antigo-testamento" class="text-vitral-dark hover:text-vitral-primary dark:text-white">Antigo Testamento</a>
      <a href="/novo-testamento" class="text-vitral-dark hover:text-vitral-primary dark:text-white">Novo Testamento</a>
      <a href="/como-ler-a-biblia" class="text-vitral-dark hover:text-vitral-primary dark:text-white">Como Ler a Bíblia</a>
    </nav>

    {/* Mobile menu button */}
    <button
      id="mobile-menu-button"
      type="button"
      aria-label="Abrir Menu"
      aria-expanded="false"
      class="md:hidden min-h-[48px] min-w-[48px] flex items-center justify-center text-vitral-dark dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800"
    >
      {/* Burger icon (default, menu closed) */}
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  {/* Mobile menu */}
  <nav id="mobile-menu" class="md:hidden hidden bg-white dark:bg-vitral-bg-dark border-b border-vitral-secondary/20">
    <div class="px-4 py-3 flex flex-col gap-3 text-sm font-medium">
      <a href="/" class="text-vitral-dark dark:text-white py-2" >Início</a>
      <a href="/antigo-testamento" class="text-vitral-dark dark:text-white py-2" >Antigo Testamento</a>
      <a href="/novo-testamento" class="text-vitral-dark dark:text-white py-2" >Novo Testamento</a>
      <a href="/como-ler-a-biblia" class="text-vitral-dark dark:text-white py-2" >Como Ler a Bíblia</a>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    menu.classList.toggle('hidden');

    // Update the icon: burger <-> X
    const svg = button.querySelector('svg');
    if (isOpen) {
      // Show burger icon (menu is closing)
      svg.innerHTML = '<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />';
    } else {
      // Show X icon (menu is opening)
      svg.innerHTML = '<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" />';
    }
  });
</script>