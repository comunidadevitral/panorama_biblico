---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { eyebrow, title, subtitle, ctaHref, ctaLabel } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
    <h1 class="hero__title">{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    {ctaHref && ctaLabel && (
      <a href={ctaHref} class="btn btn--primary hero__cta">{ctaLabel}</a>
    )}
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-primary-deep) 0%, var(--color-primary) 100%);
    color: var(--color-surface);
    padding-block: var(--space-16);
    text-align: center;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__eyebrow {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    max-width: 20ch;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    max-width: var(--container-narrow);
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 48rem) {
    .hero__title { font-size: var(--text-5xl); }
  }
</style>