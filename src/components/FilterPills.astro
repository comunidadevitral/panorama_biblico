---
import type { Categoria } from '../data/types';

interface Props {
  categorias: Categoria[];
  name: string;
}

const { categorias, name } = Astro.props;
---

<form class="filter-pills" role="radiogroup" aria-label="Filtrar por categoria">
  <input type="radio" name={name} id={`${name}-todas`} value="todas" checked />
  <label for={`${name}-todas`}>Todas</label>

  {categorias.map((cat) => (
    <>
      <input type="radio" name={name} id={`${name}-${cat.slug}`} value={cat.slug} />
      <label for={`${name}-${cat.slug}`}>{cat.label}</label>
    </>
  ))}
</form>

<style>
  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter-pills input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filter-pills label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pills label:hover {
    border-color: var(--color-primary);
  }

  .filter-pills input[type='radio']:checked + label {
    background: var(--color-primary);
    color: var(--color-surface);
    border-color: var(--color-primary);
  }

  .filter-pills input[type='radio']:focus-visible + label {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>