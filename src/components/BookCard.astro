---
// BookCard component for panorama_biblico
// Props: book, category, onView (function)
const { book, category, onView } = Astro.props;
---

<article class="card flex flex-col justify-between">
  <div class="flex-1">
    <div class="flex items-center justify-between mb-2">
      <span class="text-[0.68rem] uppercase tracking-[0.1em] font-extrabold text-primary dark:text-primary/90 bg-primary/10 dark:bg-primary/10 px-3 py-1 rounded-full">
        {category}
      </span>
    </div>
    <h3 class="block text-base font-semibold text-text dark:text-inverse mb-2">
      {book.title}
    </h3>
    <p class="text-[0.85rem] text-muted dark:text-muted/80 line-clamp-2">
      {book.description}
    </p>
  </div>
  <div class="mt-6 pt-4 border-t border-border">
    <button
      type="button"
      class="min-h-[48px] w-full px-4 py-2 rounded-lg bg-primary text-inverse font-medium text-sm hover:bg-primary/90 transition-colors"
      on:click={onView}
    >
      Assistir Panorama
    </button>
  </div>
</article>