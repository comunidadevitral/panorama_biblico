---
// Footer component for panorama_biblico
import PartnerBanner from './PartnerBanner.astro';
---

<footer class="border-t border-border bg-white dark:bg-gray-900">
  <div class="container py-10">
    <PartnerBanner />

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-border">
      <div class="flex items-center gap-2 text-sm text-muted dark:text-muted/80">
        <div class="h-6 w-6 rounded bg-gradient-to-r from-primary to-secondary" />
        <span class="font-medium">Panorama Bíblico</span>
        <span class="text-gray-400">·</span>
        <span>Comunidade Vitral</span>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400 text-center">
        &copy; {new Date().getFullYear()} Comunidade Vitral. Recursos visuais e didáticos para o estudo da Palavra de Deus. Sem fins lucrativos.
      </p>
    </div>
  </div>
</footer>