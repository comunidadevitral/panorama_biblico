---
import type { Video } from '../data/types';

interface Props {
  video: Video;
}

const { video } = Astro.props;
const youtubeUrl = `https://www.youtube.com/watch?v=${video.id}`;
const embedUrl = `https://www.youtube.com/embed/${video.id}?autoplay=1&rel=0`;
---

<article class="video-card" data-categoria={video.categoriaSlug}>
  <div class="video-card__header">
    <span class="video-card__numero">{video.numero}</span>
    <span class="video-card__categoria">{video.categoria}</span>
  </div>
  <h3 class="video-card__titulo">{video.titulo}</h3>
  {video.descritivo && <p class="video-card__descritivo">{video.descritivo}</p>}
  <a
    class="btn btn--primary video-card__cta"
    href={youtubeUrl}
    target="_blank"
    rel="noopener"
    data-video-id={video.id}
    data-video-title={video.titulo}
    data-video-embed={embedUrl}
  >
    ▶ Assistir
  </a>
</article>

<style>
  .video-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .video-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .video-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .video-card__numero {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .video-card__categoria {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .video-card__titulo {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  .video-card__descritivo {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    flex: 1;
  }

  .video-card__cta {
    align-self: flex-start;
    margin-top: auto;
  }
</style>