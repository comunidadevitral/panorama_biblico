---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import VideoDialog from '../components/VideoDialog.astro';
import { videosNT } from '../data/videos-nt';
import { videosVisaoGeral } from '../data/videos-at';
import { categoriasNT } from '../data/categorias';

const visaoGeralNT = videosVisaoGeral[1];
---

<BaseLayout
  title="Novo Testamento — Panorama Bíblico"
  description="Visões gerais de todos os livros do Novo Testamento: Evangelhos, Atos, Cartas e Apocalipse."
  canonical="/novo-testamento"
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Novo Testamento</h1>
      <p class="page-hero__subtitle">
        Visões gerais dos 27 livros do NT, do Evangelho ao Apocalipse.
      </p>
    </div>
  </section>

  <section class="section" style="padding-block: var(--space-16);">
    <div class="container">
      <h2 class="section-title">Visão Geral</h2>
      <VideoGrid videos={[visaoGeralNT]} />
    </div>
  </section>

  <div class="container">
    {categoriasNT.map((cat) => {
      const videosDaCat = videosNT.filter((v) => v.categoriaSlug === cat.slug);
      if (videosDaCat.length === 0) return null;
      return (
        <section class="section">
          <h2 class="section-title">{cat.label}</h2>
          <VideoGrid videos={videosDaCat} />
        </section>
      );
    })}
  </div>

  <VideoDialog />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-12);
    background: var(--color-primary);
    color: var(--color-surface);
    margin-bottom: var(--space-12);
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }

  .page-hero__subtitle {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
  }
</style>