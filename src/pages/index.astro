---
// Home page for panorama_biblico
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { overviewVideos } from '../../src/data/videosData.js';
---
<Layout>
  <main className="min-h-screen bg-surface-strong dark:bg-surface-dark text-text dark:text-text-inverse">
    <Hero />
    
    <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <section className="mt-16">
        <h2 className="text-2xl md:text-3xl font-semibold text-brand-petroleo dark:text-brand-white text-center">
          Visão Geral da Bíblia
        </h2>
        <div className="mt-8 grid gap-8 md:grid-cols-2">
          {/* Antigo Testamento Overview Card */}
          <div className="bg-surface-strong dark:bg-surface-dark rounded-xl p-6 border border-brand-sage/30 shadow-md flex flex-col">
            <h3 className="text-lg font-bold text-text dark:text-text-inverse mb-4">{overviewVideos.antigoTestamento.title}</h3>
            <div className="relative w-full aspect-video rounded-xl overflow-hidden bg-surface-dark/50 border border-brand-sage/20">
              <iframe
                className="absolute top-0 left-0 w-full h-full"
                src={`https://www.youtube.com/embed/${overviewVideos.antigoTestamento.youtubeId}?autoplay=1`}
                title={overviewVideos.antigoTestamento.title}
                frameBorder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowFullScreen
                loading="lazy"
              />
            </div>
            <div className="mt-6">
              <a
                href="/antigo-testamento"
                className="w-full min-h-touch px-6 py-3 inline-flex items-center justify-center rounded-lg bg-brand-petroleo text-text-inverse font-semibold shadow-md hover:shadow-lg transition"
              >
                Explorar os 39 Livros do Antigo Testamento
              </a>
            </div>
          </div>

          {/* Novo Testamento Overview Card */}
          <div className="bg-surface-strong dark:bg-surface-dark rounded-xl p-6 border border-brand-sage/30 shadow-md flex flex-col">
            <h3 className="text-lg font-bold text-text dark:text-text-inverse mb-4">{overviewVideos.novoTestamento.title}</h3>
            <div className="relative w-full aspect-video rounded-xl overflow-hidden bg-surface-dark/50 border border-brand-sage/20">
              <iframe
                className="absolute top-0 left-0 w-full h-full"
                src={`https://www.youtube.com/embed/${overviewVideos.novoTestamento.youtubeId}?autoplay=1`}
                title={overviewVideos.novoTestamento.title}
                frameBorder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowFullScreen
                loading="lazy"
              />
            </div>
            <div className="mt-6">
              <a
                href="/novo-testamento"
                className="w-full min-h-touch px-6 py-3 inline-flex items-center justify-center rounded-lg bg-brand-petroleo text-text-inverse font-semibold shadow-md hover:shadow-lg transition"
              >
                Explorar os 27 Livros do Novo Testamento
              </a>
            </div>
          </div>
        </div>
      </section>
      
      <section className="mt-16">
        <div className="bg-surface-strong dark:bg-surface-dark rounded-xl p-6 border border-brand-sage/30 shadow-md flex flex-col md:flex-row md:items-center md:gap-6">
          <div className="flex-1">
            <h3 className="text-lg font-bold text-text dark:text-text-inverse">Bible App (YouVersion)</h3>
            <p className="mt-2 text-sm text-text-muted dark:text-text-muted leading-relaxed">
              A Bíblia no seu bolso, com centenas de versões, planos de leitura e devocionais. Siga a Comunidade Vitral e caminhe com outros aprendizes. 100% gratuito, sem anúncios.
            </p>
          </div>
          <div className="mt-4 md:mt-0 md:flex-shrink-0">
            <a
              href="https://www.bible.com/organizations/79172d03-a943-4051-aebf-285b525546f1"
              target="_blank"
              rel="noopener noreferrer"
              className="min-h-touch px-6 py-3 inline-flex items-center justify-center rounded-lg bg-brand-petroleo text-text-inverse font-semibold shadow-md hover:shadow-lg transition"
            >
              Baixar
            </a>
          </div>
        </div>
      </section>
    </main>
  </Layout>